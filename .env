# ---------------------------------------------------------------------------
# Image versions — pin these so the pipeline behaves the same on every run
# ---------------------------------------------------------------------------
HADOOP_IMAGE_TAG=2.0.0-hadoop3.2.1-java8
# Base image for the custom Spark cluster image (spark/base/Dockerfile)
SPARK_IMAGE_TAG=3.5.1
AIRFLOW_BASE_IMAGE=apache/airflow:2.9.3-python3.11
POSTGRES_IMAGE_TAG=13

# ---------------------------------------------------------------------------
# Ports (host side) — change here if something collides on your laptop
# ---------------------------------------------------------------------------
NAMENODE_UI_PORT=9870
DATANODE_UI_PORT=9864
HDFS_RPC_PORT=9000

SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER_UI_PORT=8081

AIRFLOW_WEBSERVER_PORT=8082

# ---------------------------------------------------------------------------
# Airflow runs as the host user (uid) so bind-mounted ./airflow/logs,
# ./data etc. stay writable. Keep this equal to `id -u`.
# ---------------------------------------------------------------------------
AIRFLOW_UID=1000

# ---------------------------------------------------------------------------
# Airflow admin user (change the password before real use)
# ---------------------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
